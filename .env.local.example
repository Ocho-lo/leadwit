# ========== LLM 配置（可选，不设置则使用 Demo 模式）==========
# 支持任何 OpenAI 兼容 API：OpenAI / DeepSeek / 智谱 / Google Gemini 等

# API Key
OPENAI_API_KEY=sk-your-key-here

# API 地址（按需设置）
# DeepSeek:  https://api.deepseek.com
# 智谱 AI:   https://open.bigmodel.cn/api/paas/v4
# OpenAI:    https://api.openai.com/v1
# Google:    自动识别，无需设置
# OPENAI_BASE_URL=https://api.deepseek.com

# 模型（按需设置）
# DeepSeek: deepseek-chat | 智谱: glm-4-flash | OpenAI: gpt-4o-mini | Google: gemini-2.0-flash
# OPENAI_MODEL=deepseek-chat

# ========== 广告平台 OAuth（可选，仅在使用「OAuth 授权」连接时需要）==========
# 在对应平台开发者中心创建应用后填写；也可在界面使用「Token 接入」跳过此处配置。

# 巨量引擎（抖音 / 今日头条）
# OCEAN_ENGINE_APP_ID=
# OCEAN_ENGINE_SECRET=

# 磁力引擎（快手）
# KUAISHOU_APP_ID=
# KUAISHOU_SECRET=

# 腾讯广告（微信朋友圈等）
# TENCENT_ADS_CLIENT_ID=
# TENCENT_ADS_SECRET=

# ========== 自定义访问域名（可选）==========
# 域名须已接入 Cloudflare DNS（同一账号下）。填写子域名，不要带 https:// 或路径。
# 设置后执行 npm run deploy，会在 Worker 上绑定该域名并自动签发证书。
# CUSTOM_WORKER_HOST=app.yourdomain.com
